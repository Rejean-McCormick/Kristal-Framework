    {
      "id": "jcs-002",
      "name": "sorted_keys_nested",
      "description": "Object keys are sorted lexicographically at every object level; array order is preserved.",
      "profile": "kristal.v5:jcs-rfc8785",
      "artifact_type": "jcs_test_vectors",
      "content_boundary": {
        "exclude_json_pointers": []
      },
      "input": {
        "z": "last",
        "a": {
          "b": 2,
          "a": 1
        },
        "m": [
          {
            "y": true,
            "x": false
          },
          null,
          "text"
        ]
      },
      "expected_canonical": "{\"a\":{\"a\":1,\"b\":2},\"m\":[{\"x\":false,\"y\":true},null,\"text\"],\"z\":\"last\"}",
