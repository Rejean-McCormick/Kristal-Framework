{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kristal.org/schemas/v5/referent-registry.schema.json",
  "title": "Kristal Referent Registry v1",
  "description": "Domain-neutral registry of stable referents used by epistemic assertions. Classification is deliberately shallow; domain ontologies remain extensions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "registry_id",
    "scope",
    "referents"
  ],
  "properties": {
    "schema_version": {
      "const": "5.0"
    },
    "artifact_type": {
      "const": "referent_registry"
    },
    "profile_version": {
      "const": "1.0.0"
    },
    "registry_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "domain"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "referents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/referent"
      }
    },
    "external_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "system",
          "id"
        ],
        "properties": {
          "system": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "revision": {
            "type": "string"
          },
          "content_hash": {
            "type": "string"
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "kind": {
      "type": "string",
      "enum": [
        "person",
        "collective",
        "work",
        "edition",
        "manifestation",
        "document",
        "concept",
        "place",
        "installation",
        "activity",
        "process",
        "event",
        "physical_object",
        "system",
        "other"
      ]
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "lang": {
          "type": "string",
          "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$"
        }
      }
    },
    "external_id": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "id"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "referent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "kind",
        "labels"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*:[^\\s]+$"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/label"
          }
        },
        "description": {
          "type": "string"
        },
        "external_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/external_id"
          }
        },
        "classifications": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
