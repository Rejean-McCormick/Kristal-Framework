{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kristal v11 dictionary catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "catalog_id",
    "namespace_id",
    "languages"
  ],
  "properties": {
    "schema_version": {
      "const": "11.0"
    },
    "artifact_type": {
      "const": "kristal_dictionary_catalog"
    },
    "catalog_id": {
      "type": "string",
      "minLength": 1
    },
    "namespace_id": {
      "type": "string",
      "minLength": 1
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag",
          "fallbacks",
          "layers"
        ],
        "properties": {
          "tag": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
          },
          "fallbacks": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
            }
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "layer_id",
                "kind",
                "priority",
                "path",
                "sha256"
              ],
              "properties": {
                "layer_id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "wikidata",
                    "curated",
                    "external"
                  ]
                },
                "priority": {
                  "type": "integer",
                  "minimum": 0
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "source_snapshot": {
                  "type": "string",
                  "minLength": 1
                },
                "source_system": {
                  "type": "string",
                  "minLength": 1
                },
                "license": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "wikidata"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "source_snapshot"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "external"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "then": {
                    "required": [
                      "source_snapshot",
                      "source_system",
                      "license"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
