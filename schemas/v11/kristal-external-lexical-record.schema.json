{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kristal v11 reviewed external lexicon record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace_id",
    "semantic_id",
    "language",
    "preferred_term",
    "source_system",
    "source_snapshot",
    "source_record_id",
    "license",
    "alignment"
  ],
  "properties": {
    "namespace_id": {
      "type": "string",
      "minLength": 1
    },
    "semantic_id": {
      "type": "string",
      "pattern": "^K[QP][1-9][0-9]*$"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "preferred_term": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_system": {
      "type": "string",
      "minLength": 1
    },
    "source_snapshot": {
      "type": "string",
      "minLength": 1
    },
    "source_record_id": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "reviewer",
        "evidence_refs"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^KS[1-9][0-9]*$"
          }
        }
      }
    }
  }
}
