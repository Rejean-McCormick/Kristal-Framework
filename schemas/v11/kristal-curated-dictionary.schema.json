{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Kristal v11 reviewed curated dictionary layer",
  "type":"object", "additionalProperties":false,
  "required":["schema_version","artifact_type","namespace_id","language","entries"],
  "properties":{
    "schema_version":{"const":"11.0"},
    "artifact_type":{"const":"kristal_curated_dictionary"},
    "namespace_id":{"type":"string","minLength":1},
    "language":{"type":"string","pattern":"^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"},
    "entries":{"type":"array","items":{
      "type":"object", "additionalProperties":false,
      "required":["semantic_id","preferred_term","review"],
      "properties":{
        "semantic_id":{"type":"string","pattern":"^K[QP][1-9][0-9]*$"},
        "preferred_term":{"type":"string","minLength":1},
        "alternate_terms":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "definition":{"type":"string"},
        "review":{"type":"object","additionalProperties":false,"required":["decision_id","reviewer","reason"],"properties":{
          "decision_id":{"type":"string","minLength":1},
          "reviewer":{"type":"string","minLength":1},
          "reason":{"type":"string","minLength":1}
        }}
      }
    }}
  }
}
