{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kristall derived query index manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "index_id",
    "authoritative",
    "rebuildable",
    "built_from",
    "indexes"
  ],
  "properties": {
    "schema_version": {
      "const": "8.0"
    },
    "artifact_type": {
      "const": "kristall_query_index"
    },
    "index_id": {
      "type": "string",
      "minLength": 1
    },
    "authoritative": {
      "const": false
    },
    "rebuildable": {
      "const": true
    },
    "built_from": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "byte_sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "byte_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-fA-F]{64}$"
          },
          "semantic_fingerprint": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile",
              "digest"
            ],
            "properties": {
              "profile": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-fA-F]{64}$"
              }
            }
          },
          "schema_version": {
            "type": "string"
          }
        }
      }
    },
    "indexes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "location"
        ],
        "properties": {
          "kind": {
            "enum": [
              "identity_lookup",
              "incoming_edges",
              "outgoing_edges",
              "predicate_usage",
              "assertions_by_entity",
              "evidence_by_assertion",
              "source_support",
              "capability_implementers",
              "lexicalization",
              "temporal",
              "custom"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-fA-F]{64}$"
          },
          "profile": {
            "type": "string"
          }
        }
      }
    }
  }
}
