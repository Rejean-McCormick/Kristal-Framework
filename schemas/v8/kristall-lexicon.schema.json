{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kristall lexical Kristal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "lexicon_id",
    "language",
    "scope",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "8.0"
    },
    "artifact_type": {
      "const": "kristall_lexicon"
    },
    "lexicon_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "default_script": {
      "type": "string",
      "pattern": "^[A-Za-z]{4}$"
    },
    "direction": {
      "enum": [
        "ltr",
        "rtl",
        "auto"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "core",
            "domain",
            "education_level",
            "geography",
            "project",
            "mixed"
          ]
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identity_space",
              "id"
            ],
            "properties": {
              "identity_space": {
                "enum": [
                  "kristall",
                  "kristal_v6",
                  "external"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "education_levels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identity_space",
              "id"
            ],
            "properties": {
              "identity_space": {
                "enum": [
                  "kristall",
                  "kristal_v6",
                  "external"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identity_space",
              "id"
            ],
            "properties": {
              "identity_space": {
                "enum": [
                  "kristall",
                  "kristal_v6",
                  "external"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "target_kristals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "semantic_ref",
          "lexical_status"
        ],
        "properties": {
          "semantic_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identity_space",
              "id"
            ],
            "properties": {
              "identity_space": {
                "enum": [
                  "kristall",
                  "kristal_v6",
                  "external"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "lexical_status": {
            "enum": [
              "resolved",
              "missing",
              "deprecated",
              "conflicted"
            ]
          },
          "preferred_term": {
            "type": "string",
            "minLength": 1
          },
          "alternate_terms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "part_of_speech": {
            "type": "string",
            "minLength": 1
          },
          "grammatical_features": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          },
          "definition_gloss": {
            "type": "string"
          },
          "usage_notes": {
            "type": "string"
          },
          "provenance": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_ref"
              ],
              "properties": {
                "source_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": "string"
                },
                "license": {
                  "type": "string"
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "lexical_status": {
                  "const": "resolved"
                }
              },
              "required": [
                "lexical_status"
              ]
            },
            "then": {
              "required": [
                "preferred_term"
              ]
            }
          }
        ]
      }
    }
  }
}
