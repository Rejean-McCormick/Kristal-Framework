{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kristal:schema:v10:node-manifest",
  "title": "Kristal v10 Node Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "node_id",
    "roles",
    "semantic_state_contracts",
    "bindings"
  ],
  "properties": {
    "schema_version": {
      "const": "10.0"
    },
    "artifact_type": {
      "const": "kristal_node_manifest"
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "collection",
          "directory",
          "publisher",
          "gateway"
        ]
      }
    },
    "semantic_state_contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "string",
      "minLength": 1
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding_id",
          "profile",
          "descriptor"
        ],
        "properties": {
          "binding_id": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "descriptor": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "directories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
