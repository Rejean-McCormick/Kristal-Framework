{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kristal:schema:v9:logical-artifact",
  "title": "Kristal v9 Logical Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "logical_contract",
    "payload",
    "logical_commitment"
  ],
  "properties": {
    "schema_version": {
      "const": "9.0"
    },
    "artifact_type": {
      "const": "kristal_logical_artifact"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "logical_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "payload": {},
    "logical_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "digest"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "identity_profile": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object"
    },
    "authority_ref": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "logical_contract",
          "logical_commitment"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "logical_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "logical_commitment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile",
              "digest"
            ],
            "properties": {
              "profile": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          },
          "authority_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
