{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kristal:schema:v9:derivation",
  "title": "Kristal v9 Derivation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "transform",
    "inputs",
    "parameters",
    "outputs",
    "determinism"
  ],
  "properties": {
    "schema_version": {
      "const": "9.0"
    },
    "artifact_type": {
      "const": "kristal_derivation"
    },
    "derivation_id": {
      "type": "string",
      "minLength": 1
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "logical_contract",
              "logical_commitment"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "logical_contract": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "version"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "logical_commitment": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "profile",
                  "digest"
                ],
                "properties": {
                  "profile": {
                    "type": "string",
                    "minLength": 1
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              },
              "authority_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state_ref",
              "logical_commitment"
            ],
            "properties": {
              "state_ref": {
                "type": "string",
                "minLength": 1
              },
              "logical_commitment": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "profile",
                  "digest"
                ],
                "properties": {
                  "profile": {
                    "type": "string",
                    "minLength": 1
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              },
              "authority_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "parameters": {
      "type": "object"
    },
    "toolchain": {
      "type": "object"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "logical_contract",
          "logical_commitment"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "logical_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "logical_commitment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile",
              "digest"
            ],
            "properties": {
              "profile": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          },
          "authority_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimed"
      ],
      "properties": {
        "claimed": {
          "type": "boolean"
        },
        "profile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "object"
    }
  }
}
