{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kristal:schema:v9:materialization-manifest",
  "title": "Kristal v9 Materialization Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "source",
    "profile",
    "segments",
    "reconstructability"
  ],
  "properties": {
    "schema_version": {
      "const": "9.0"
    },
    "artifact_type": {
      "const": "kristal_materialization_manifest"
    },
    "materialization_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "logical_contract",
        "logical_commitment"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "logical_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "logical_commitment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "digest"
          ],
          "properties": {
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "authority_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "partition_spec": {
      "type": "object"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_key",
          "blob"
        ],
        "properties": {
          "segment_key": {
            "type": "string",
            "minLength": 1
          },
          "record_count": {
            "type": "integer",
            "minimum": 0
          },
          "blob": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "media_type",
              "digest",
              "size"
            ],
            "properties": {
              "media_type": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "compression": {
                "type": "string",
                "minLength": 1
              },
              "encryption": {
                "type": "object"
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "logical_range": {
            "type": "object"
          }
        }
      }
    },
    "dictionaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "media_type",
          "digest",
          "size"
        ],
        "properties": {
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "compression": {
            "type": "string",
            "minLength": 1
          },
          "encryption": {
            "type": "object"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "omitted": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "reconstructability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lossless"
      ],
      "properties": {
        "lossless": {
          "type": "boolean"
        },
        "profile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
