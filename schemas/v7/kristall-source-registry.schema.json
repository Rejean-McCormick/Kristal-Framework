{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source registry",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "artifact_type",
    "namespace_id",
    "registry_id",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "7.0"
    },
    "artifact_type": {
      "const": "kristall_source_registry"
    },
    "namespace_id": {
      "type": "string"
    },
    "registry_id": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "source_id",
          "title",
          "status"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^KS[1-9][0-9]*$"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "superseded",
              "withdrawn"
            ]
          }
        }
      }
    }
  }
}
