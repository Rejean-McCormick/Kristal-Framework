{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Property registry",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "artifact_type",
    "namespace_id",
    "registry_id",
    "properties"
  ],
  "properties": {
    "schema_version": {
      "const": "7.0"
    },
    "artifact_type": {
      "const": "kristall_property_registry"
    },
    "namespace_id": {
      "type": "string"
    },
    "registry_id": {
      "type": "string"
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "property_id",
          "preferred_label",
          "status"
        ],
        "properties": {
          "property_id": {
            "type": "string",
            "pattern": "^KP[1-9][0-9]*$"
          },
          "preferred_label": {
            "type": "string"
          },
          "status": {
            "enum": [
              "provisional",
              "stable",
              "deprecated"
            ]
          },
          "external_ids": {
            "type": "array"
          }
        }
      }
    }
  }
}
