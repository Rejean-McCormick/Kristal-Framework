{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kristal.example/schema/v7/kristall-toc-registry.schema.json",
  "title": "Kristall TOC Registry",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "artifact_type",
    "namespace_id",
    "registry_id",
    "category_model",
    "categories",
    "subjects"
  ],
  "properties": {
    "schema_version": {
      "const": "7.0"
    },
    "artifact_type": {
      "const": "kristall_toc_registry"
    },
    "namespace_id": {
      "type": "string"
    },
    "registry_id": {
      "type": "string"
    },
    "category_model": {
      "type": "object",
      "required": [
        "reference_kos",
        "polyhierarchical_subjects"
      ],
      "properties": {
        "reference_kos": {
          "type": "string"
        },
        "polyhierarchical_subjects": {
          "const": true
        },
        "country_domain_default_role": {
          "enum": [
            "facet",
            "category"
          ]
        }
      },
      "additionalProperties": true
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "category_id",
          "label",
          "category_role",
          "external_alignment"
        ],
        "properties": {
          "category_id": {
            "type": "string",
            "pattern": "^KQ[1-9][0-9]*$"
          },
          "label": {
            "type": "string"
          },
          "category_role": {
            "enum": [
              "knowledge_category",
              "facet_category"
            ]
          },
          "external_alignment": {
            "type": "object",
            "required": [
              "kos_id",
              "external_uri",
              "notation",
              "mapping_semantics"
            ],
            "properties": {
              "kos_id": {
                "type": "string"
              },
              "external_uri": {
                "type": "string"
              },
              "notation": {
                "type": "string"
              },
              "mapping_semantics": {
                "enum": [
                  "exactMatch",
                  "closeMatch",
                  "broadMatch",
                  "narrowMatch",
                  "relatedMatch",
                  "classifiedIn"
                ]
              }
            }
          }
        }
      }
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "subject_id",
          "label",
          "status",
          "category_placements"
        ],
        "properties": {
          "subject_id": {
            "type": "string",
            "pattern": "^KQ[1-9][0-9]*$"
          },
          "label": {
            "type": "string"
          },
          "status": {
            "enum": [
              "seed",
              "active",
              "deprecated"
            ]
          },
          "natural_angle": {
            "type": "string"
          },
          "category_placements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "category_id",
                "placement"
              ],
              "properties": {
                "category_id": {
                  "type": "string"
                },
                "placement": {
                  "enum": [
                    "primary",
                    "secondary",
                    "related"
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "external_concept_mappings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "preferred_axis_type_ids": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "string",
              "pattern": "^KQ[1-9][0-9]*$"
            }
          },
          "source_kristal_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
